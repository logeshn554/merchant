{
  "name": "allgo-merchant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build",
    "build:staging": "node scripts/check-release.mjs --environment=staging && vite build --mode staging",
    "build:production": "node scripts/check-release.mjs --environment=production && vite build --mode production",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "npm run test:ui && npm --prefix functions test",
    "test:ui": "node --import tsx --test tests/ui/*.test.ts",
    "mobile:start": "cd mobile && npx expo start",
    "mobile:android": "cd mobile && npx expo run:android",
    "mobile:ios": "cd mobile && npx expo run:ios",
    "android:add": "npx cap add android",
    "android:sync": "npm run build:production && npx cap sync android",
    "android:open": "npx cap open android",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build:production && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "dev:api": "node server/accounts.mjs",
    "install:backend": "npm --prefix functions install",
    "build:development": "vite build --mode development",
    "start": "node server/start-production.mjs",
    "android:sync:development": "npm run build:development && npx cap sync android && node scripts/prepare-native.mjs",
    "ios:build:simulator": "npm run build:development && npx cap sync ios && node scripts/prepare-native.mjs && node scripts/build-ios.mjs",
    "ios:check:simulator": "node scripts/check-ios-artifact.mjs"
  },
  "dependencies": {
    "@capacitor-firebase/app-check": "^8.5.2",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor-firebase/messaging": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@firebase/app": "^0.16.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "capacitor-razorpay": "^1.3.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^2.15.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/app-compat": "^0.5.18",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6",
    "uuid": "11.1.1"
  }
}
